{
  "name": "jean-code",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A coding agent that grows smarter every day. Terminal-first. Everywhere-accessible. Open by default.",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "bun --cwd packages/cli dev",
    "jean": "bun packages/cli/src/index.ts",
    "build": "tsc --build",
    "build:native": "cargo build --release -p pi-natives && cargo build --profile ffi -p pi-ffi",
    "typecheck": "tsc --build",
    "test": "bun test",
    "test:rust": "cargo test --workspace",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "rm -rf packages/*/dist .turbo target"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.3.14"
}
