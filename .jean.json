{
  // Testing configuration: every model role points at a free model so a run
  // cannot cost anything.
  //
  // `default` alone would not be enough. A sub-agent spawn uses `smol`, a
  // commit message uses `commit`, and the advisor uses `advisor` — each would
  // silently reach a paid model while the main conversation looked free.
  //
  // Revert by deleting this file: the built-in defaults are the paid models.
  "mode": "autonomous",

  "model": {
    "provider": "openrouter",
    "modelId": "poolside/laguna-s-2.1:free"
  },

  "agents": {
    "default": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 8192, "temperature": 0 },
    "smol": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 4096 },
    "slow": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 8192 },
    "plan": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 8192 },
    "commit": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 1024 },
    "vision": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 4096 },
    "designer": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 8192 },
    "task": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 4096 },
    "advisor": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 4096 },
    "tiny": { "model": "poolside/laguna-s-2.1:free", "maxTokens": 2048 }
  },

  // The advisor makes a second model call per turn to review the first. Free or
  // not, that doubles the requests against a rate-limited free tier, and this
  // is testing rather than work worth double-checking.
  "advisor": { "enabled": false }
}
