{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@codebuff/sdk": ["packages/tui2/src/compat/sdk.ts"],
      "@codebuff/common/*": ["packages/tui2/src/compat/common.ts"],
      "@codebuff/common": ["packages/tui2/src/compat/common.ts"],
      "@jean/core": ["packages/core/src/index.ts"],
      "@jean/agent": ["packages/agent/src/index.ts"],
      "@jean/teams": ["packages/teams/src/index.ts"],
      "@jean/subagents": ["packages/subagents/src/index.ts"],
      "@jean/advisor": ["packages/advisor/src/index.ts"],
      "@jean/tools": ["packages/tools/src/index.ts"],
      "@jean/git": ["packages/git/src/index.ts"],
      "@jean/memory": ["packages/memory/src/index.ts"],
      "@jean/skills": ["packages/skills/src/index.ts"],
      "@jean/mcp": ["packages/mcp/src/index.ts"],
      "@jean/plugins": ["packages/plugins/src/index.ts"],
      "@jean/model": ["packages/model/src/index.ts"],
      "@jean/native": ["packages/native/src/index.ts"],
      "@jean/tui2": ["packages/tui2/src/index.ts"],
      "@jean/gateway": ["packages/gateway/src/index.ts"],
      "@jean/execution": ["packages/execution/src/index.ts"],
      "@jean/scheduler": ["packages/scheduler/src/index.ts"],
      "@jean/collab": ["packages/collab/src/index.ts"],
      "@jean/cli": ["packages/cli/src/index.ts"],
      "@jean/config": ["packages/config/src/index.ts"],
      "@jean/acp": ["packages/acp/src/index.ts"],
      "@jean/sdk": ["packages/sdk/src/index.ts"],
      "@jean/projects": ["packages/projects/src/index.ts"],
      "@jean/evals": ["packages/evals/src/index.ts"],
      "@jean/hooks": ["packages/hooks/src/index.ts"],
      "@jean/commands": ["packages/commands/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "target", ".reference"]
}
